        <mxCell id="124" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=22;fontColor=#182536;fontStyle=1;strokeColor=none;fillColor=none;" value="Why the curves differ" vertex="1">
          <mxGeometry height="30" width="590" x="744" y="715" as="geometry" />
        </mxCell>
        <mxCell id="125" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=18;fontColor=#182536;fontStyle=0;strokeColor=none;fillColor=none;" value="&lt;b&gt;M1:&lt;/b&gt; Vɢʙ stays fixed. The sweep does not drive the body surface toward accumulation. The small Cgg decrease can come from bias-dependent gate coupling." vertex="1">
          <mxGeometry height="74" width="588" x="744" y="758" as="geometry" />
        </mxCell>
        <mxCell id="126" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=18;fontColor=#182536;fontStyle=0;strokeColor=none;fillColor=none;" value="&lt;b&gt;M2:&lt;/b&gt; Vɢʙ becomes more negative. Below the flat-band voltage, holes accumulate beneath the oxide; strong accumulation raises intrinsic gate-to-body capacitance toward CₒₓA." vertex="1">
          <mxGeometry height="85" width="588" x="744" y="845" as="geometry" />
        </mxCell>
        <mxCell id="127" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=18;fontColor=#A97700;fontStyle=1;strokeColor=none;fillColor=none;" value="The rise is accumulation of holes, not an NMOS inversion channel." vertex="1">
          <mxGeometry height="38" width="588" x="744" y="945" as="geometry" />
        </mxCell>
        <mxCell id="128" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=20;fontColor=#182536;fontStyle=1;strokeColor=none;fillColor=none;" value="Cgg = ∂Qɢ / ∂Vɢ  with Vᴅ, Vѕ and Vʙ held fixed at each DC bias point." vertex="1">
          <mxGeometry height="32" width="1320" x="40" y="1018" as="geometry" />
        </mxCell>
        <mxCell id="129" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=16;fontColor=#526276;fontStyle=0;strokeColor=none;fillColor=none;" value="For an AC check, replace the gate ground with a DC 0 V + small AC test source; hold D, S and B at AC ground. Exact magnitudes and the initial dip depend on the model." vertex="1">
          <mxGeometry height="39" width="1320" x="40" y="1056" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
