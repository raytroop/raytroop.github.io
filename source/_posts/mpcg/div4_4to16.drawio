        <mxCell id="review-v-430" value="Timing condition" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=24;fontColor=#222222;fontStyle=1;">
          <mxGeometry x="36" y="1464" width="1298" height="30" as="geometry" />
        </mxCell>
        <mxCell id="review-v-431" value="δ is the raw divider-edge delay relative to its launching ph edge at the retimer." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=18;fontColor=#222222;fontStyle=0;">
          <mxGeometry x="36" y="1501" width="1300" height="26" as="geometry" />
        </mxCell>
        <mxCell id="review-v-432" value="δ_min &amp;gt; t_hold  and  δ_max + t_setup &amp;lt; 3 UI, including relative clock skew and jitter." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=20;fontColor=#222222;fontStyle=1;">
          <mxGeometry x="36" y="1533" width="1300" height="28" as="geometry" />
        </mxCell>
        <mxCell id="review-v-433" value="Divider jitter is suppressed within this window. Reference jitter, retimer noise and mismatch remain." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=18;fontColor=#222222;fontStyle=0;">
          <mxGeometry x="36" y="1569" width="1300" height="26" as="geometry" />
        </mxCell>
        <mxCell id="review-v-434" value="oph&amp;lt;k+8&amp;gt; = NOT oph&amp;lt;k&amp;gt;. Later PulseGen logic creates the 2 UI track pulses." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=18;fontColor=#222222;fontStyle=0;">
          <mxGeometry x="36" y="1601" width="1300" height="26" as="geometry" />
        </mxCell>
        <mxCell id="review-v-435" value="The original divider state fixes the absolute phase labels; reset/synchronization must reproduce it." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=18;fontColor=#475569;fontStyle=0;">
          <mxGeometry x="36" y="1633" width="1300" height="26" as="geometry" />
        </mxCell>
