        <mxCell id="review-v-262" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=20;fontColor=#222222;fontStyle=0;" value="The existing retimer wiring and output labels are consistent with positive divider delay and the rising-edge convention above." vertex="1">
          <mxGeometry height="36" width="2100" x="120" y="5587" as="geometry" />
        </mxCell>
        <mxCell id="review-v-263" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=20;fontColor=#222222;fontStyle=0;" value="For each raw edge, measure δ from its nominal launching ph edge to D at the retimer. Require δ_min &amp;gt; t_hold and δ_max + t_setup &amp;lt; 3 UI." vertex="1">
          <mxGeometry height="36" width="2100" x="120" y="5627" as="geometry" />
        </mxCell>
        <mxCell id="review-v-264" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=20;fontColor=#222222;fontStyle=0;" value="Include relative clock skew and jitter in these bounds. Even-numbered outputs capture after 4 UI; odd-numbered outputs capture after 3 UI." vertex="1">
          <mxGeometry height="36" width="2100" x="120" y="5667" as="geometry" />
        </mxCell>
        <mxCell id="review-v-265" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=20;fontColor=#222222;fontStyle=0;" value="Retiming suppresses divider-added edge jitter while the selected sample stays unchanged. Reference-clock jitter, DFF noise and mismatch remain." vertex="1">
          <mxGeometry height="36" width="2100" x="120" y="5707" as="geometry" />
        </mxCell>
        <mxCell id="review-v-266" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=20;fontColor=#222222;fontStyle=0;" value="The upper divider plots show ideal logical phase only. Real propagation delay is represented in the retimer input plot above." vertex="1">
          <mxGeometry height="36" width="2100" x="120" y="5747" as="geometry" />
        </mxCell>
        <mxCell id="review-v-267" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=20;fontColor=#222222;fontStyle=0;" value="Reset/synchronization must establish the shown divider state. The downstream PulseGen creates the separate 2 UI / 12.5% track pulses." vertex="1">
          <mxGeometry height="36" width="2100" x="120" y="5787" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
