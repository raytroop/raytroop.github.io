        </mxCell>
        <mxCell id="c102" value="a⁺ = ¬(a ∨ b),   b⁺ = a;   reset (a,b) = (0,0)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=2;fontFamily=Helvetica;fontSize=20;fontColor=#202A35;fontSize=21;fontColor=#202A35;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="50" y="1012" width="790" height="32" />
        </mxCell>
        <mxCell id="c103" value="(a,b): 00 → 10 → 01 → 00.  u = a rises once every 3 input cycles." style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=2;fontFamily=Helvetica;fontSize=20;fontColor=#202A35;fontSize=18;fontColor=#586778;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="50" y="1048" width="790" height="28" />
        </mxCell>
        <mxCell id="c104" value="D = yb;  reset y = 0" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=2;fontFamily=Helvetica;fontSize=20;fontColor=#202A35;fontSize=21;fontColor=#202A35;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="930" y="1012" width="340" height="32" />
        </mxCell>
        <mxCell id="c105" value="Each u rising edge toggles y." style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=2;fontFamily=Helvetica;fontSize=20;fontColor=#202A35;fontSize=18;fontColor=#586778;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="930" y="1048" width="340" height="28" />
        </mxCell>
        <mxCell id="c106" value="Based on J. Im et al., JSSC 2021, Sec. IV-B and Fig. 9. Reset-sequencer internals are not disclosed in the paper." style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=2;fontFamily=Helvetica;fontSize=20;fontColor=#202A35;fontSize=15;fontColor=#586778;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="30" y="1091" width="1260" height="24" />
        </mxCell>
