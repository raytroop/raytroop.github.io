        <mxCell id="n111" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontColor=#666666;" value="d&lt;sub&gt;3&lt;/sub&gt;, d&lt;sub&gt;7&lt;/sub&gt;, d&lt;sub&gt;11&lt;/sub&gt;, d&lt;sub&gt;15&lt;/sub&gt;, …" vertex="1">
          <mxGeometry height="12" width="150" x="404" y="628" as="geometry" />
